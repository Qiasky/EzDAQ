.brand-header { margin-bottom: 28rpx; }.brand-name { font-size: 34rpx; font-weight: 750; letter-spacing: -.7rpx; }.brand-sub { font-size: 20rpx; color: #6c9191; font-weight: 500; letter-spacing: 1rpx; }
.hero { background: #173e45; border-radius: 24rpx; padding: 30rpx 32rpx; color: #fff; position: relative; overflow: hidden; }.hero-label { color: #a4bebf; font-size: 22rpx; }.hero-live { font-size: 20rpx; color: #b0d8c9; }.hero-site { font-size: 31rpx; font-weight: 600; margin-top: 12rpx; }.hero-bottom { margin-top: 20rpx; position: relative; z-index: 1; }.online-number { font-size: 68rpx; font-weight: 650; line-height: 1.1; letter-spacing: -2rpx; }.online-unit { font-size: 29rpx; color: #afd1c9; margin-left: 8rpx; }.hero-info { text-align: right; font-size: 24rpx; line-height: 1.9; }.hero-decoration { position: absolute; width: 320rpx; height: 320rpx; border: 36rpx solid #255158; border-radius: 50%; right: -120rpx; bottom: -190rpx; }
.kpi-grid { display: flex; gap: 16rpx; margin-top: 20rpx; }.kpi { flex: 1; padding: 22rpx 20rpx; }.kpi-value { font-size: 45rpx; font-weight: 650; margin: 5rpx 0; line-height: 1.2; }.kpi-unit { font-size: 20rpx; font-weight: 400; margin-left: 9rpx; color: #8c9ba4; }.kpi-desc { font-size: 19rpx; color: #a1acb4; }.danger { color: #c56350; }
.alarm-strip { padding: 21rpx 22rpx; background: #fff3df; color: #9e702b; border-radius: 14rpx; margin-top: 24rpx; font-size: 23rpx; }.alarm-strip-icon { display: inline-block; width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center; border: 2rpx solid #c09047; border-radius: 50%; margin-right: 12rpx; }.alarm-strip-sub { margin-left: 16rpx; font-size: 20rpx; color: #b29569; }.calm-strip { padding: 20rpx; background: #e9f4f0; color: #367e6c; border-radius: 14rpx; margin-top: 24rpx; font-size: 23rpx; }
.section-count { color: #94a2aa; font-size: 23rpx; margin-left: 14rpx; font-weight: 400; }.scan-icon { font-size: 34rpx; vertical-align: middle; }.area-row { padding: 0 1rpx; }.search { margin-top: 18rpx; }.device-card { padding: 26rpx 26rpx 0; margin-bottom: 20rpx; }.device-location { margin-top: 6rpx; font-size: 21rpx; }.device-metrics { display: flex; padding: 25rpx 0 19rpx; }.device-metric { flex: 1; padding-left: 22rpx; border-left: 1rpx solid #e9eef0; }.device-metric:first-child { padding-left: 0; border: none; }.device-foot { font-size: 20rpx; color: #9aa7af; padding: 16rpx 0; border-top: 1rpx solid #eff2f4; }.device-foot .chevron { font-size: 26rpx; }.offline-note { padding: 26rpx 0; color: #a0a9b0; font-size: 22rpx; }
