.alarm-summary { display: flex; align-items: baseline; justify-content: space-between; margin: 30rpx 0 14rpx; }.summary-number { font-size: 80rpx; line-height: 1; font-weight: 650; color: #c26452; letter-spacing: -3rpx; }.summary-label { color: #89949c; font-size: 25rpx; margin-left: 16rpx; }.summary-right { color: #9c824f; font-size: 23rpx; }.filters { margin-top: 32rpx; }.alarm-list-heading { margin-bottom: 16rpx; }.alarm-card { padding: 26rpx 26rpx 0; margin-bottom: 20rpx; border-left: 5rpx solid #8facc6; }.alarm-card.level-critical { border-left-color: #d37265; }.alarm-card.level-warn { border-left-color: #d7a34d; }.alarm-device { font-size: 23rpx; color: #72828d; margin-left: 16rpx; max-width: 280rpx; }.alarm-message { font-size: 29rpx; font-weight: 600; line-height: 1.55; margin: 21rpx 0 14rpx; }.alarm-reading { display: flex; gap: 32rpx; color: #8c99a2; font-size: 23rpx; padding-bottom: 8rpx; }.reading-value { color: #b36e4e; font-weight: 600; margin-left: 10rpx; }.alarm-actions { margin-top: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #edf1f3; }.action-button { font-size: 23rpx; padding: 12rpx 25rpx; border-radius: 10rpx; }.alarm-expanded { padding: 18rpx 0; color: #81929b; font-size: 22rpx; line-height: 1.9; border-top: 1rpx dashed #e4e9ec; margin-top: 20rpx; }.alarm-note { background: #f3f7f6; border-radius: 10rpx; padding: 16rpx; color: #668077; font-size: 23rpx; margin-top: 16rpx; }.load-more { margin: 24rpx auto; }
