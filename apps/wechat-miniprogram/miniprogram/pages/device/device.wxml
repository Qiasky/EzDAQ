<view class="page">
  <view class="row detail-top"><text class="eyebrow">DEVICE INSIGHT</text><view class="source {{source.isDemo ? 'demo' : ''}}" bindtap="onSettings">{{source.label}} ›</view></view>
  <view wx:if="{{error}}" class="card empty"><view class="empty-symbol">◫</view><view class="empty-title">设备暂不可用</view><view class="small muted">{{error}}</view><button class="secondary" bindtap="onRetry">{{device ? '重新加载' : '重试 / 扫码'}}</button></view>
  <view wx:elif="{{loading}}" class="card skeleton"><view class="skeleton-line"></view><view class="skeleton-line short"></view></view>
  <block wx:elif="{{device}}">
    <view class="device-hero card"><view class="row"><view class="device-icon {{device.type}}">{{device.type === 'power' ? 'ϟ' : device.type === 'sensor' ? '◉' : '◫'}}</view><text class="badge {{device.status}}"><text class="dot {{device.status}}"></text>{{device.statusText}}</text></view><view class="detail-name">{{device.name}}</view><view class="small muted">{{device.site}}</view><view class="row detail-id"><text>{{device.deviceId}}</text><text>{{device.snapshotOnly ? '快照' : '上报'}} {{device.lastReportText}}</text></view></view>
    <view wx:if="{{device.status === 'offline'}}" class="error-banner">设备已离线。下列值为最后一次采样，请现场检查通讯连接。</view>
    <view class="row section-head"><text class="section-title">实时监控</text><text class="small muted">{{device.typeText}}</text></view>
    <view wx:if="{{metrics.length}}" class="metric-grid"><view wx:for="{{metrics}}" wx:key="key" class="card metric-tile"><view class="metric-label">{{item.label}}</view><view class="tile-reading"><text class="metric-value">{{item.value}}</text><text class="metric-unit">{{item.unit}}</text></view><view class="tile-caption">{{item.caption || (device.status === 'offline' ? '最后有效值' : source.isDemo ? '演示采样' : '最新采样值')}}</view></view></view>
    <view wx:else class="card empty compact"><view class="small muted">暂无监控点数据</view></view>
    <view class="row section-head"><text class="section-title">历史趋势</text><text class="small muted">24h</text></view>
    <view class="card trend-card"><view wx:if="{{numericMetrics.length && device.status !== 'offline'}}" class="metric-tabs"><view wx:for="{{numericMetrics}}" wx:key="key" class="metric-tab {{selectedMetric === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onMetric">{{item.label}}</view></view><view wx:if="{{chartLoading}}" class="chart-placeholder">正在读取趋势…</view><view wx:elif="{{chartError}}" class="chart-placeholder">{{chartError}}</view><canvas wx:elif="{{chartPoints.length}}" id="trendCanvas" type="2d" class="trend-canvas"></canvas><view wx:else class="chart-placeholder">{{chartCaption}}</view><view wx:if="{{chartPoints.length}}" class="row chart-stats"><text>最低 <text class="chart-stat-value">{{chartMin}}</text> {{chartUnit}}</text><text>最高 <text class="chart-stat-value">{{chartMax}}</text> {{chartUnit}}</text></view><view wx:if="{{chartPoints.length}}" class="chart-caption">{{chartCaption}}</view></view>
    <view class="row section-head"><text class="section-title">设备档案</text></view>
    <view class="card archive"><view class="row archive-row"><text class="muted">设备型号</text><text>{{device.model || '未提供'}}</text></view><view class="row archive-row"><text class="muted">设备位置</text><text class="archive-value">{{device.site || '未标注'}}</text></view><view class="row archive-row"><text class="muted">接入协议</text><text>{{device.sourceText}}</text></view><view class="row archive-row"><text class="muted">设备编号</text><text>{{device.deviceId}}</text></view></view>
    <view class="row section-head"><text class="section-title">最近告警</text><button class="plain" bindtap="onAlarm">去告警中心 ›</button></view>
    <view class="card recent-alarms"><view wx:for="{{alarms}}" wx:key="_id" class="recent-alarm"><view class="row"><text class="badge {{item.level}}">{{item.levelText}}</text><text class="small muted">{{item.statusText}}</text></view><view class="recent-message">{{item.message}}</view><view class="small muted">{{item.fullTime}}</view><view wx:if="{{item.note}}" class="small muted recent-note">处理说明：{{item.note}}</view></view><view wx:if="{{!alarms.length}}" class="empty compact small muted">该设备暂无告警记录</view></view>
    <button class="primary detail-action" open-type="share">分享设备状态</button>
  </block>
</view>
