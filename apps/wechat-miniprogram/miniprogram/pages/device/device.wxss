.detail-top { margin-bottom: 24rpx; }.device-hero { padding: 28rpx; }.device-hero .device-icon { width: 76rpx; height: 76rpx; font-size: 43rpx; }.detail-name { font-size: 39rpx; font-weight: 650; margin: 20rpx 0 8rpx; }.detail-id { padding-top: 24rpx; margin-top: 24rpx; border-top: 1rpx solid #ecf1f3; font-size: 22rpx; color: #8e9ca5; }.metric-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }.metric-tile { width: calc(50% - 9rpx); padding: 26rpx; }.tile-reading { padding-top: 12rpx; }.tile-reading .metric-value { font-size: 45rpx; }.tile-caption { font-size: 20rpx; color: #a1adb4; padding-top: 12rpx; }.trend-card { padding: 24rpx; }.metric-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }.metric-tab { background: #f2f5f6; color: #88959e; border-radius: 10rpx; padding: 9rpx 19rpx; font-size: 21rpx; }.metric-tab.active { background: #e8f4ef; color: #187c6c; }.trend-canvas { width: 100%; height: 260rpx; display: block; }.chart-placeholder { padding: 52rpx 20rpx; text-align: center; color: #98a4ac; font-size: 23rpx; }.chart-stats { color: #92a0a8; font-size: 20rpx; margin-top: 16rpx; }.chart-stat-value { color: #497b6d; font-size: 24rpx; font-weight: 600; }.chart-caption { color: #9ba8ae; text-align: center; font-size: 19rpx; margin-top: 17rpx; }.archive { padding: 0 26rpx; }.archive-row { padding: 23rpx 0; border-bottom: 1rpx solid #edf1f3; font-size: 24rpx; }.archive-row:last-child { border: none; }.archive-value { max-width: 400rpx; text-align: right; }.recent-alarm { padding: 26rpx; border-bottom: 1rpx solid #edf1f3; }.recent-alarm:last-child { border: none; }.recent-message { font-size: 26rpx; font-weight: 550; margin: 16rpx 0 10rpx; }.recent-note { margin-top: 12rpx; }.detail-action { margin-top: 32rpx; }.compact { padding: 36rpx 24rpx; }
