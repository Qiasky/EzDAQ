.mine-logo { margin: 0; width: 64rpx; height: 64rpx; line-height: 64rpx; }.profile { margin-top: 30rpx; padding: 32rpx 28rpx 22rpx; }.avatar { width: 94rpx; height: 94rpx; background: #e6f3ee; color: #2d8271; border-radius: 26rpx; font-size: 38rpx; display: flex; align-items: center; justify-content: center; margin-right: 23rpx; font-weight: 600; }.profile-name { font-size: 34rpx; font-weight: 650; margin-bottom: 8rpx; }.profile-source { border-top: 1rpx solid #eaf0ee; margin-top: 30rpx; padding-top: 20rpx; }.shortcuts { display: flex; gap: 20rpx; margin-top: 20rpx; }.shortcut { flex: 1; padding: 26rpx; font-size: 27rpx; font-weight: 550; }.shortcut .small { font-size: 20rpx; font-weight: 400; margin-top: 7rpx; }.shortcut-icon { font-size: 48rpx; line-height: 1.1; color: #448f80; margin-bottom: 17rpx; }.alarm-shortcut { color: #b78a45; }.menu { padding: 0 26rpx; }.menu-row { padding: 25rpx 0; border-bottom: 1rpx solid #edf1f3; font-size: 26rpx; }.menu-row:last-child { border-bottom: 0; }.menu-row .small { font-size: 20rpx; margin-top: 5rpx; }.menu-icon { width: 53rpx; font-size: 31rpx; color: #7a9994; }.connection-panel { padding: 22rpx 0 28rpx; border-bottom: 1rpx solid #edf1f3; }.connection-intro { margin-bottom: 20rpx; }.mode-option { border: 1rpx solid #e7edee; padding: 20rpx; border-radius: 13rpx; margin-bottom: 14rpx; }.mode-option.selected { border-color: #53a192; background: #f1f8f5; }.mode-title { font-size: 25rpx; font-weight: 600; margin-bottom: 4rpx; }.mode-option .small { font-size: 20rpx; }.radio { width: 27rpx; height: 27rpx; border: 2rpx solid #ced9d6; border-radius: 50%; }.radio.checked { border: 7rpx solid #338d7c; }.connection-hint { padding: 20rpx; background: #f6f8f9; border-radius: 12rpx; margin-top: 20rpx; font-size: 24rpx; }.env-id { font-size: 21rpx; color: #648276; margin: 9rpx 0; word-break: break-all; }.connection-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.connection-actions button { flex: 1; padding: 18rpx 10rpx; }.field-label { font-size: 22rpx; margin: 22rpx 0 10rpx; color: #7f8d96; }.field { border: 1rpx solid #e0e7e9; background: #f8fafb; border-radius: 12rpx; padding: 20rpx; height: 82rpx; font-size: 23rpx; }.field-hint { margin-top: 16rpx; font-size: 20rpx; }.success-message { padding: 20rpx; color: #3d8c76; background: #edf7f1; border-radius: 12rpx; font-size: 22rpx; margin-top: 20rpx; }.help-panel { padding: 20rpx; background: #f6f9f8; color: #728980; font-size: 23rpx; line-height: 2; border-radius: 12rpx; }.help-panel .small { margin-top: 20rpx; }.mine-footer { margin-top: 48rpx; text-align: center; }.footer-brand { color: #92aaa4; font-size: 34rpx; font-weight: 700; margin-bottom: 5rpx; }.footer-brand text { font-size: 20rpx; font-weight: 400; }
