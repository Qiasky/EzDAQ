/* components/empty-state/index.wxss */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
}

/* 空态图形：三条横线代表列表 */
.icon-empty {
  width: 96rpx;
  height: 72rpx;
  border: 4rpx solid #d6dae0;
  border-radius: 10rpx;
  position: relative;
}

.icon-empty::before,
.icon-empty::after {
  content: '';
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  height: 4rpx;
  background: #d6dae0;
  border-radius: 2rpx;
}

.icon-empty::before { top: 20rpx; }
.icon-empty::after { top: 38rpx; right: 40rpx; }

/* 搜索态：一个圆 + 一根柄 */
.icon-search {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #d6dae0;
  border-radius: 50%;
  position: relative;
}

.icon-search::after {
  content: '';
  position: absolute;
  right: -20rpx;
  bottom: -14rpx;
  width: 32rpx;
  height: 4rpx;
  background: #d6dae0;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

/* 错误态：一个圆 + 感叹号 */
.icon-error {
  width: 76rpx;
  height: 76rpx;
  border: 4rpx solid #d03b3b;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d03b3b;
  font-size: 44rpx;
  font-weight: 500;
}

.et-title {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.et-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aa1ac;
  text-align: center;
  line-height: 1.6;
}

.et-btn {
  margin-top: 36rpx;
  padding: 16rpx 44rpx;
  border: 2rpx solid #12324f;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #12324f;
}

.et-btn:active {
  background: rgba(18, 50, 79, 0.06);
}