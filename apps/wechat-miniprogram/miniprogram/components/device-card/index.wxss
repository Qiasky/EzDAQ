/* components/device-card/index.wxss */
.device-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  /* 左侧色条：状态在余光里也能识别 */
  border-left: 6rpx solid transparent;
}

.st-border-normal { border-left-color: #2a9d5c; }
.st-border-warn { border-left-color: #e08a1e; }
.st-border-fault { border-left-color: #d03b3b; }
.st-border-offline { border-left-color: #9aa1ac; }
.st-border-maintain { border-left-color: #4a7fb5; }

/* 头部：名称 + 状态 + 箭头 */
.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1c2128;
  margin-left: 12rpx;
  /* 长名称省略，避免挤压状态标签 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.st-bg-normal { background: #2a9d5c; }
.st-bg-warn { background: #e08a1e; }
.st-bg-fault { background: #d03b3b; }
.st-bg-offline { background: #9aa1ac; }
.st-bg-maintain { background: #4a7fb5; }

.arrow {
  font-size: 40rpx;
  color: #c5c9d0;
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 元信息行 */
.row-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* 指标行 */
.row-metrics {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.metric {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.metric-label {
  font-size: 22rpx;
  color: #9aa1ac;
  margin-right: 6rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #1c2128;
}

.metric-over {
  color: #d03b3b;
}

.metric-unit {
  font-size: 20rpx;
  color: #9aa1ac;
  margin-left: 2rpx;
}