{
  "name": "ezdaq-wechat-miniprogram",
  "version": "0.2.2",
  "private": true,
  "description": "EzDAQ EPS native WeChat inspection client",
  "scripts": {
    "check": "node scripts/check.js",
    "check:native": "node scripts/check-native.cjs",
